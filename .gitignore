# Security - Sensitive Files
# Never commit private keys, mnemonics, or secrets!

# Environment variables
.env
.env.*
.env.local
.env.*.local
!.env.example

# Blockchain/Crypto Sensitive Files
*.key
*.pem
*.keystore
**/keystore/**
**/wallets/**
wallet.json
mnemonic.txt
seed.txt
private-key.txt
privatekey.txt

# Secrets and credentials
**/secrets/**
**/credentials/**
secrets.json
credentials.json
auth.json

# API Keys and Tokens
api-keys.txt
tokens.txt
*.token

# Configuration files that might contain secrets
config.local.*
local.config.*

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/
vendor/
.pnp
.pnp.js

# Build outputs
dist/
build/
*.bundle.js
*.bundle.js.map

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
